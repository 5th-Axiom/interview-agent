DATABASE_URL=postgres://interview_agent:local_interview_only@localhost:55432/interview_agent
# APP_ENV=staging explicitly enables isolated test deployments with a production build.
# Unset APP_ENV defaults to production when NODE_ENV=production; fixed OTP remains forbidden there.
APP_URL=http://localhost:3100
NEXT_PUBLIC_RELAY_URL=ws://localhost:3101
RELAY_PORT=3101
AUTH_SECRET=replace-with-at-least-32-random-characters
PHONE_HASH_SECRET=replace-with-another-32-random-characters
DEV_TEST_MODE=true
ALLOW_TEST_OTP=true
# Test login is independent of voice mode and is always forbidden in production.
DEV_ADMIN_PASSWORD=local-recruiter
# Required for APP_ENV=staging; independent site-wide account (scrypt salt:hash).
TEST_ACCESS_USERNAME=
TEST_ACCESS_PASSWORD_HASH=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
TTS_PROVIDER=openai
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
ASR_PROVIDER=deepgram
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TOKENDANCE_API_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
# For TokenDance set TTS_PROVIDER=tokendance and a supported TTS_VOICE.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
SMS_URL=
SMS_TOKEN=
ADMIN_PASSWORD_HASH=
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=interview_local
S3_SECRET_KEY=interview_local_storage_only
S3_BUCKET=interview-agent-private
# Optional fallback: same tools and context contract, only before first output
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Runtime settings are frozen on new sessions. Keep the upgraded Worker when rolling features back.
VOICE_RUNTIME_V2=true
VOICE_AUDIO_PIPELINE=true
VOICE_CONVERSATION_VIEW=true
VOICE_CONTEXT_BUDGET=true
ASR_SILENCE_MS=900
# Only true behind the supplied proxy, which overwrites X-Real-IP and X-Forwarded-For.
TRUST_PROXY=false
# Purpose-specific values fall back to LLM_* when empty. Never put API keys in session metadata.
INTERVIEW_MODEL=
INTERVIEW_BASE_URL=
INTERVIEW_API_KEY=
SUMMARY_MODEL=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
ASSESSMENT_MODEL=
ASSESSMENT_BASE_URL=
ASSESSMENT_API_KEY=
INTERVIEW_CONTEXT_WINDOW=32768
INTERVIEW_MAX_INPUT=24000
INTERVIEW_OUTPUT_RESERVE=800
INTERVIEW_SAFETY_MARGIN=2048
SUMMARY_CONTEXT_WINDOW=32768
SUMMARY_MAX_INPUT=24000
SUMMARY_OUTPUT_RESERVE=6000
SUMMARY_SAFETY_MARGIN=2048
ASSESSMENT_CONTEXT_WINDOW=32768
ASSESSMENT_MAX_INPUT=24000
ASSESSMENT_OUTPUT_RESERVE=6000
ASSESSMENT_SAFETY_MARGIN=2048
INTERVIEW_CONCURRENCY=8
SUMMARY_CONCURRENCY=1
ASSESSMENT_CONCURRENCY=1
# Optional, explicit candidate for synthetic replay; does not switch the application's model.
EVAL_CANDIDATE_MODEL=
EVAL_CANDIDATE_BASE_URL=
EVAL_CANDIDATE_API_KEY=
